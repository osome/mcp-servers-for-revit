<Page x:Class="revit_mcp_plugin.UI.ConnectionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Connection Settings" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="The MCP service only accepts connections from this computer (127.0.0.1)."
                       Foreground="#666666" Margin="0,5,0,0"/>
        </StackPanel>
        <!-- Port -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Port" FontWeight="SemiBold"/>
            <TextBox x:Name="PortTextBox" Width="120" Height="26" HorizontalAlignment="Left"
                     VerticalContentAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock x:Name="PortHintTextBlock" Foreground="#666666" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" Margin="0,15,0,0"/>
        </StackPanel>
        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Reset to Default" Width="120" Height="30" Margin="0,0,10,0" Click="ResetButton_Click"/>
            <Button Content="Save" Width="80" Height="30" Background="#0078D7" Foreground="White"
                   Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
